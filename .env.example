# ============================================
# Configuration (non-secret values)
# ============================================
MYSQL_DATABASE=ynov_ci
MYSQL_USER=root
MYSQL_HOST=db

# ============================================
# Secrets (Docker Secrets)
# ============================================
# Create the secrets directory and add your MySQL password:
#   mkdir -p .secrets
#   echo "your_password" > .secrets/mysql_root_password
#
# The password is read from .secrets/mysql_root_password
# and injected via Docker Secrets (never stored in plain text in config files).
